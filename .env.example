# YNAB API Configuration
# Get your token from: https://app.ynab.com/settings/developer

# Your YNAB API token
YNAB_API_TOKEN=your_api_token_here

# Budget ID (optional - if not specified, will use the default budget)
YNAB_BUDGET_ID=

# Account mappings (map from bank_account to YNAB account_id)
# Format: BANK_ACCOUNT=account_id
# You can find account IDs in your YNAB API
OCBC_DEFAULT=
POSB_EVERYDAY_USE=
POSB_MY_SAVINGS=
